  ProcessActivityDateTime    DateTime @satria.DateTime
  LastModifiedBy             String   @satria.VarChar(100)
  LastModified               DateTime @satria.DateTime

  vwProcessAssign vwProcessAssign2All @relation(fields: [ProcessAssignID], references: [ID], onUpdate: NoAction, map: "fk_vwProcessAssign_activity")
}

