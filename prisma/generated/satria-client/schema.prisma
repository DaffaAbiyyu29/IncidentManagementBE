model excelBaseUrl {
  id         Int          @id @default(autoincrement())
  guid       String       @unique
  excelName  String?
  url        String?      @unique
  created_at DateTime
  updated_at DateTime
  excelSheet excelSheet[]
}

model excelSheet {
  id           Int          @id @default(autoincrement())
  guid         String
  sheetName    String?
  created_at   DateTime
  updated_at   DateTime
  excelBaseUrl excelBaseUrl @relation(fields: [guid], references: [guid], onDelete: Cascade)
}

model log {
  id         Int      @id @default(autoincrement())
  guid       String?  @unique
  name       String?
  type       String?
  row        Int?
  created_at DateTime
  updated_at DateTime
}

model ms_users {
  id                                              Int              @id(map: "PK_ms_users") @default(autoincrement())
  name                                            String?          @unique(map: "IX_ms_users_name") @satria.VarChar(100)
  username                                        String?          @unique(map: "IX_ms_users_username") @satria.VarChar(255)
  password                                        String?          @satria.VarChar(255)
  divisi                                          String?          @satria.VarChar(100)
  departemen                                      String?          @satria.VarChar(100)
  email                                           String?          @satria.VarChar(100)
  role                                            Int?
  created_at                                      DateTime?        @satria.Date
  updated_at                                      DateTime?        @satria.Date
  trx_LogHistory_trx_LogHistory_PICBAToms_users   trx_LogHistory[] @relation("trx_LogHistory_PICBAToms_users")
  trx_LogHistory_trx_LogHistory_PICUserToms_users trx_LogHistory[] @relation("trx_LogHistory_PICUserToms_users")
}

model Schedule_Recommendation {
