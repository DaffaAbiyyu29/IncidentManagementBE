model siteRoute {
  id         Int      @id @default(autoincrement())
  guid       String   @unique
  baseUrl    String?
  siteName   String?  @unique
  url        String?  @unique
  created_at DateTime
  updated_at DateTime
}

model sysdiagrams {
  name         String @satria.NVarChar(128)
  principal_id Int
  diagram_id   Int    @id(map: "PK__sysdiagr__C2B05B61632F454B") @default(autoincrement())
  version      Int?
  definition   Bytes?

  @@unique([principal_id, name], map: "UK_principal_name")
}

model trx_PICA {
  PICAID         Int              @id(map: "PK__trx_PICA__3214EC277441A7ED") @default(autoincrement())
  IncidentID     Int
  created_at     DateTime?        @satria.Date
  created_by     Int?
  update_at      DateTime?        @satria.Date
  update_by      Int?
  trx_LogHistory trx_LogHistory?  @relation(fields: [IncidentID], references: [ID], onDelete: NoAction, onUpdate: NoAction, map: "FK_trx_PICA_trx_LogHistory")
  trx_DetailPICA trx_DetailPICA[]
}

model trx_DetailPICA {
  DetailPICAID     Int       @id(map: "PK__trx_DetailPICA__3214EC27AAA12345")
  PICAID           Int?
  Status           String?   @satria.VarChar(100)
  Problem          String?   @satria.VarChar(255)
  RootCaused       String?   @satria.VarChar(255)
  CorrectiveAction String?   @satria.VarChar(255)
  PreventiveAction String?   @satria.VarChar(255)
  trx_PICA         trx_PICA? @relation(fields: [PICAID], references: [PICAID], onDelete: NoAction, onUpdate: NoAction, map: "FK_trx_DetailPICA_trx_PICA")
}

model users {
  id         Int      @id @default(autoincrement())
  guid       String   @unique
  name       String   @unique
  username   String   @unique
  password   String
  created_at DateTime
  updated_at DateTime
}

